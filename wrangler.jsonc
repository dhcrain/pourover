{
  "name": "pourover",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "analytics_engine_datasets": [
    { "binding": "STATS", "dataset": "pourover_stats" }
  ]
}
