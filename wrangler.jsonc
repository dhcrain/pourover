{
  "name": "pourover",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ACCOUNT_ID": "2f005bc85fa106ef5efcbab654cc668e" },
  "analytics_engine_datasets": [
    { "binding": "STATS", "dataset": "pourover_stats" }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
